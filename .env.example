# ==============================================================================
# SyncCode Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# MongoDB connection string (Local MongoDB or MongoDB Atlas)
MONGODB_URI="mongodb+srv://synccode_user:YOUR_PASSWORD@cluster0.mongodb.net/synccode_db?retryWrites=true&w=majority"

# JWT Secret Key (Base64 encoded 256-bit key for Spring Security token signing)
JWT_SECRET="c3luY2NvZGUtc2VjdXJlLWp3dC0yNTYtYml0LXNlY3JldC1rZXktd2l0aC1lbm91Z2gtZW50cm9weQ=="

# ------------------------------------------------------------------------------
# 2. OPTIONAL BACKEND & NETWORK SETTINGS (Sensible Defaults Applied)
# ------------------------------------------------------------------------------
PORT=8080
JWT_EXPIRATION_MS=86400000
FRONTEND_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. COLLABORATION SERVICE (Yjs WebSocket Microservice)
# ------------------------------------------------------------------------------
# COLLABORATION_PORT: Port where Yjs WebSocket server listens (Defaults to 1234)
COLLABORATION_PORT=1234
ALLOWED_ORIGIN="http://localhost:3000"
# Note: The collaboration service cryptographically validates JWT tokens directly
# in-process using JWT_SECRET with zero external HTTP validation roundtrips.

# ------------------------------------------------------------------------------
# 4. OPTIONAL WEBRTC / LIVEKIT CALLING
# Direct browser WebRTC media streams (camera, microphone, screen sharing) work
# out of the box. These settings are optional for connecting to a hosted LiveKit Cloud instance.
# ------------------------------------------------------------------------------
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ------------------------------------------------------------------------------
# 5. OPTIONAL CODE EXECUTION (NO PAID API REQUIRED)
# Code execution is an OPTIONAL server-side feature. By default, leave these EMPTY.
# When empty, code execution is cleanly disabled, and the UI gracefully displays:
# "Code execution is not configured yet."
# Collaborative editing, chat, presence, snapshots, and video calls remain 100% operational.
# If you later deploy a self-hosted Judge0 CE or Docker sandbox, specify its URL here.
# ------------------------------------------------------------------------------
EXECUTION_SERVICE_URL=""
EXECUTION_API_KEY=""

# ------------------------------------------------------------------------------
# 6. OPTIONAL CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:8080/api/v1"
VITE_COLLABORATION_WS_URL="ws://localhost:1234"
VITE_LIVEKIT_URL=""
